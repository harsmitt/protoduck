# name: test/sql/protoduck.test
# description: smoke tests for protoduck scalar functions
# group: [protoduck]

statement error
SELECT proto_schema_add('syntax = "proto3"; message M { string s = 1; }');
----
Catalog Error: Scalar Function with name proto_schema_add does not exist!

require protoduck

statement ok
SELECT proto_schema_add('
    syntax = "proto3";
    package demo;
    enum Status { UNKNOWN = 0; ACTIVE = 1; INACTIVE = 2; }
    message Address { string city = 1; string country = 2; }
    message Person {
        string name = 1;
        int32 age = 2;
        Status status = 3;
        Address address = 4;
        repeated string tags = 5;
        map<string, string> attributes = 6;
    }
');

query I
SELECT length(proto_describe('demo.Person')) > 0;
----
true

query T
SELECT proto_describe(NULL) IS NULL;
----
true

statement error
SELECT proto_describe('demo.Missing');
----
Message type 'demo.Missing' not found. Did you load the schema with proto_schema_add()?

query T
SELECT proto_schema_add(NULL) IS NULL;
----
true

statement error
SELECT proto_schema_add('syntax = "proto3"; message Broken {');
----
Failed to parse proto schema:

query T
SELECT proto_get('\x0a\x05Alice\x10\x1e'::BLOB, 'demo.Person', 'name');
----
Alice

query T
SELECT proto_get('\x0a\x05Alice\x10\x1e'::BLOB, 'demo.Person', 'age');
----
30

query T
SELECT proto_to_json('\x0a\x05Alice\x10\x1e'::BLOB, 'demo.Person') LIKE '%"name":%Alice%';
----
true

query T
SELECT proto_decode('\x0a\x05Alice\x10\x1e'::BLOB, 'demo.Person') LIKE '%"age":%30%';
----
true

# JSON -> protobuf returns the protobuf wire bytes as a DuckDB BLOB.
query T
SELECT proto_to_json(
    proto_from_json(
        '{"name":"Alice","age":30,"status":"ACTIVE","address":{"city":"Bengaluru","country":"India"},"tags":["one","two"],"attributes":{"source":"test"}}',
        'demo.Person'
    ), 'demo.Person'
) = '{"name":"Alice","age":30,"status":"ACTIVE","address":{"city":"Bengaluru","country":"India"},"tags":["one","two"],"attributes":{"source":"test"}}';
----
true

query T
SELECT json_to_proto('{"name":"Bob","age":41}', 'demo.Person') IS NOT NULL;
----
true

query T
SELECT proto_from_json(NULL, 'demo.Person') IS NULL;
----
true

query T
SELECT proto_from_json('{"name":"Bob"}', NULL) IS NULL;
----
true

statement error
SELECT proto_from_json('{bad json}', 'demo.Person');
----
Failed to deserialize JSON: Invalid JSON:

statement error
SELECT proto_from_json('{"unknown":1}', 'demo.Person');
----
Field 'unknown' not found in message type 'demo.Person'

statement error
SELECT proto_from_json('{"age":"not-a-number"}', 'demo.Person');
----
Invalid value for field 'age': expected integer or integer string, got string

statement error
SELECT proto_from_json('{"status":"MISSING"}', 'demo.Person');
----
Invalid value for field 'status': expected enum demo.Status name, got MISSING

statement error
SELECT proto_from_json('{"name":1}', 'demo.Person');
----
Invalid value for field 'name': expected string, got number

statement ok
SELECT proto_schema_add('
    syntax = "proto3";
    package maptest;
    message NumericMaps {
        map<int64, string> signed_values = 1;
        map<uint64, string> unsigned_values = 2;
    }
');

query T
SELECT proto_to_json(
    proto_from_json(
        '{"signed_values":{"-1":"negative","42":"signed"},"unsigned_values":{"1":"unsigned"}}',
        'maptest.NumericMaps'
    ), 'maptest.NumericMaps'
) = '{"signed_values":{"-1":"negative","42":"signed"},"unsigned_values":{"1":"unsigned"}}';
----
true

statement ok
SELECT proto_schema_add('
    syntax = "proto3";
    package advanced;
    enum Kind { ZERO = 0; ONE = 1; }
    message Payload {
        bytes data = 1;
        repeated int32 numbers = 2;
        Kind kind = 3;
    }
');

query T
SELECT proto_to_json(
    proto_from_json('{"data":"SGVsbG8=","numbers":[1,2,3],"kind":1}', 'advanced.Payload'),
    'advanced.Payload'
) = '{"data":"SGVsbG8=","numbers":[1,2,3],"kind":"ONE"}';
----
true

# google.protobuf.Timestamp uses canonical ProtoJSON RFC 3339 strings.
statement ok
SELECT proto_schema_add('
    syntax = "proto3";
    package timestamp_test;
    import "google/protobuf/timestamp.proto";
    message Event { google.protobuf.Timestamp created_at = 1; }
');

query T
SELECT proto_to_json(
    proto_from_json('{"created_at":"2025-06-15T10:30:00.123Z"}', 'timestamp_test.Event'),
    'timestamp_test.Event'
) = '{"created_at":"2025-06-15T10:30:00.123Z"}';
----
true

query T
SELECT proto_to_json(
    proto_from_json('{"created_at":"2025-06-15T10:30:00+05:30"}', 'timestamp_test.Event'),
    'timestamp_test.Event'
) = '{"created_at":"2025-06-15T05:00:00Z"}';
----
true

query T
SELECT proto_from_json('{"created_at":"1970-01-01T00:00:00Z"}', 'timestamp_test.Event') IS NOT NULL;
----
true

statement error
SELECT proto_from_json('{"created_at":"not-a-timestamp"}', 'timestamp_test.Event');
----
Failed to deserialize JSON: Invalid Timestamp:

query T
SELECT proto_get(NULL::BLOB, 'demo.Person', 'name') IS NULL;
----
true

statement error
SELECT proto_get('\x0a\x05Alice\x10\x1e'::BLOB, 'demo.Person', 'missing_field');
----
Field 'missing_field' not found in message type 'demo.Person'

statement error
SELECT proto_to_json('\x0a\x05Alice\x10\x1e'::BLOB, 'demo.Missing');
----
Message type 'demo.Missing' not found. Did you load the schema with proto_schema_add()?
